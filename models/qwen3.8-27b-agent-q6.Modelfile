# Qwen 3.8-27B UD-Q6_K_XL (unsloth, ~25 GB) für Agenten und grosse, genaue Anfragen.
# Praktisch verlustfrei gegenüber dem Original, ca. 20-25 % langsamer als Q4_K_M.
# Vorher:     ollama pull hf.co/unsloth/Qwen3.8-27B-GGUF:UD-Q6_K_XL
# Erstellen:  ollama create qwen3.8:27b-agent-q6 -f models/qwen3.8-27b-agent-q6.Modelfile
#
# R9700 32 GB allein: 128k Kontext (~30 GB). Mit zusätzlicher RX 7800 XT (48 GB): num_ctx 262144 möglich.
# Chat-Template kommt aus der GGUF-Datei (beim IQ3-Test die bessere Wahl für Tool-Calls).
# Bewusst kein SYSTEM-Prompt: der Client (Copilot) schickt eigene Anweisungen.
FROM hf.co/unsloth/Qwen3.8-27B-GGUF:UD-Q6_K_XL

PARAMETER temperature 0.3
PARAMETER top_k 20
PARAMETER top_p 0.8
PARAMETER min_p 0
PARAMETER presence_penalty 0
PARAMETER repeat_penalty 1

PARAMETER num_ctx 131072
