# Qwen 3.8-27B Q4_K_M für Agenten und Tool-Calls (z.B. GitHub Copilot über die Ollama-API).
# Gleiche Dateien wie qwen3.8:27b, kein zusätzlicher Speicher. Nur andere Parameter.
# Gemessen auf AMD Radeon AI PRO R9700 32 GB, KV-Cache q8_0 + Flash Attention:
#   131072 Kontext -> ~18 GB, 100% GPU, ~41 t/s Ausgabe.
# Erstellen:  ollama create qwen3.8:27b-agent -f models/qwen3.8-27b-agent.Modelfile
#
# Template/Renderer/Parser kommen vom Basismodell (saubere Tool-Calls + Thinking).
# Bewusst kein SYSTEM-Prompt: der Client (Copilot) schickt eigene Anweisungen.
FROM qwen3.8:27b

# Niedrige Temperatur für stabile Tool-Calls
PARAMETER temperature 0.3
PARAMETER top_k 20
PARAMETER top_p 0.8
PARAMETER min_p 0
PARAMETER presence_penalty 0
PARAMETER repeat_penalty 1

# Voller Kontext, passt komplett in 32 GB VRAM
PARAMETER num_ctx 131072
