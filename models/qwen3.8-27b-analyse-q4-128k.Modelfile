# ============================================================
# qwen3.8:27b-analyse-q4-128k
# ============================================================
#
# WOFÜR
#   Faktenbasierte Analyse:
#   - Logs und Fehler auswerten, Root Cause finden
#   - Code lesen und schreiben
#   - Funktioniert mit Tool-Calls (Copilot, MCP, API)
#
# EIGENSCHAFTEN
#   Basis:          Qwen 3.8 27B, Q4_K_M (dicht), gleiche Dateien wie qwen3.8:27b
#   Kontext:        128k Tokens, ca. 23 GB VRAM inkl. KV-Cache, passt auf die R9700
#                   (nur mit OLLAMA_NUM_PARALLEL=1, bei 2 reicht der VRAM nicht)
#   Tempo:          ca. 57 t/s dank Multi-Token-Prediction (im Basismodell enthalten)
#   System-Prompt:  keiner, den Kontext gibt der Client mit
#   Backend:        Vulkan (OLLAMA_VULKAN=1, HIP_VISIBLE_DEVICES=-1)
#
# PARAMETER
#   Name               Wert     Standard  Zweck
#   temperature        0        1         deterministisch, keine erfundenen Details
#   top_k              20       -         Qwen-Empfehlung, wirkt bei temp 0 kaum
#   top_p              0.95     -         Qwen-Empfehlung, wirkt bei temp 0 kaum
#   presence_penalty   1.5      0         gegen Wiederholungs-Schleifen
#   num_ctx            131072   -         Platz für lange Logs und grosse Copilot-Unterhaltungen
#   ("Standard" = Wert von qwen3.8:27b ohne Anpassung, "-" = nicht verglichen)
#
# ERSTELLEN
#   ollama create qwen3.8:27b-analyse-q4-128k -f models/qwen3.8-27b-analyse-q4-128k.Modelfile
# ============================================================
FROM qwen3.8:27b

PARAMETER temperature 0
PARAMETER top_k 20
PARAMETER top_p 0.95
PARAMETER presence_penalty 1.5
PARAMETER num_ctx 131072
