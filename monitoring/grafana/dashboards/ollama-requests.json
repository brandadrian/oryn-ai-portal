{
 "uid": "ollama-requests",
 "title": "Ollama Anfragen (Tabelle)",
 "tags": [
  "ollama",
  "copilot"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "30s",
 "templating": {
  "list": [
   {
    "name": "client",
    "label": "Client",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki-local"
    },
    "query": {
     "label": "client",
     "refId": "A",
     "stream": "{job=\"ollama-api\"}",
     "type": 1
    },
    "definition": "label_values({job=\"ollama-api\"}, client)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "refresh": 2
   },
   {
    "name": "model",
    "label": "Modell",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki-local"
    },
    "query": {
     "label": "model",
     "refId": "A",
     "stream": "{job=\"ollama-api\"}",
     "type": 1
    },
    "definition": "label_values({job=\"ollama-api\"}, model)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "refresh": 2
   }
  ]
 },
