# Kopieren nach .env.<instanz> (z.B. .env.staging, .env.production, .env.geschenkkoerbe; gitignored) und ausfüllen.
# Start: docker compose --env-file .env.staging up -d

# Name der Instanz (bestimmt Projektname, Volume und Traefik-Router)
APP_ENV=staging

# Domain dieses Open WebUI
WEBUI_HOST=shopware-chat-staging.oryn.brandadrian.com
# zufällig erzeugen, z.B.: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Der eine Benutzer (wird beim ersten Start angelegt)
WEBUI_ADMIN_NAME=Shopware
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=

# Modell
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_MODEL=qwen3.8:27b

# Shopware: einziger Unterschied zwischen staging und production ist die URL (und die Integration dazu)
# Basis-URL des Shops, ohne /api und ohne / am Ende
SHOPWARE_URL=https://staging.example-shop.de
# Admin -> Einstellungen -> System -> Integrationen: Zugangs-ID / Sicherheitsschlüssel
SHOPWARE_CLIENT_ID=
SHOPWARE_CLIENT_SECRET=

# Schlüssel zwischen Open WebUI und MCP-Container, zufällig erzeugen: openssl rand -hex 32
MCPO_API_KEY=

# Optional: Name im Browser-Tab und auf der Login-Seite
WEBUI_NAME=

# Optional: OpenAI statt/zusätzlich zu Ollama
ENABLE_OLLAMA=true
ENABLE_OPENAI=false
OPENAI_API_KEY=
# true = einfache Benutzer sehen das Modell ohne Freigabe pro Modell (nötig, wenn es einen einfachen Benutzer gibt)
BYPASS_MODEL_ACCESS_CONTROL=false

# Optional: einfacher Benutzer (nur chatten, kaum Einstellungen). Leer lassen = kein zweiter Benutzer.
CHAT_USER_NAME=
CHAT_USER_EMAIL=
CHAT_USER_PASSWORD=
