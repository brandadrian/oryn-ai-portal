# Copy to .env and fill in. Never commit .env.
SSH_HOST=185.88.214.149
SSH_USER=sftp-user-1
SSH_PORT=22
# Private key whose public key is set on the SFTP user in the Managed Center
SSH_KEY_FILE=~/.ssh/id_rsa
SSH_KNOWN_HOSTS=~/.ssh/known_hosts
# Path for the file browser, relative to the SFTP "Arbeitsordner" (empty = whole folder)
SFTP_PATH=
LOKI_REMOTE_PORT=3100

# Modelle über die Oryn-API (OpenAI-kompatibel). Funktioniert auch, wenn waeb-operations auf einem anderen Rechner läuft.
LLM_API_BASE_URL=https://ollama-api.oryn.brandadrian.com/v1
LLM_API_KEY=
# ENABLE_OLLAMA=true   # nur auf dem Ollama-Rechner: zusätzlich Ollama direkt ohne Key
# Optionaler einmaliger Incident-Agent: lokales Ollama muss für Container erreichbar sein.
# INVESTIGATION_OLLAMA_URL=http://host.docker.internal:11434/v1
# INVESTIGATION_MODEL=qwen3.8:27b-q4-128k
# INVESTIGATION_MAX_CALLS=100

# Open WebUI (only applied on first start with an empty volume)
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=

# Optional (Defaults in docker-compose.yml)
# DEFAULT_MODEL=qwen3.5:35b-a3b-q4-256k
# WEBUI_HOST_PORT=3010
# LOKI_HOST_PORT=3110
# Öffentlich über Traefik (Netz "proxy")
# Zufälliger, fester Schlüssel für Sessions: python -c "import secrets;print(secrets.token_hex(32))"
WEBUI_PROD_SECRET_KEY=
WEBUI_STAGING_SECRET_KEY=
# WAEB_PROD_HOST=waeb-operations.oryn.brandadrian.com
# WAEB_STAGING_HOST=waeb-operations-staging.oryn.brandadrian.com

# Log-Dashboard (Grafana, nur lokal http://localhost:3020)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# GRAFANA_HOST_PORT=3020


# MYSQL_HOST_PORT=3316
# PROMETHEUS_HOST_PORT=9190

# ===== PRODUCTION (www.geschenkkoerbe.ch) =====
SHOPWARE_PROD_URL=https://www.geschenkkoerbe.ch
SHOPWARE_PROD_CLIENT_ID=
SHOPWARE_PROD_CLIENT_SECRET=
# Zufallswert, schützt den Shopware-MCP: python -c "import secrets;print(secrets.token_hex(24))"
MCPO_PROD_KEY=
# SHOPWARE_PROD_READONLY=true
MYSQL_PROD_USER=
MYSQL_PROD_PASSWORD=
MYSQL_PROD_DB=

# ===== STAGING (shopware-staging.geschenkkoerbe.ch) =====
SHOPWARE_STAGING_URL=https://shopware-staging.geschenkkoerbe.ch
SHOPWARE_STAGING_CLIENT_ID=
SHOPWARE_STAGING_CLIENT_SECRET=
MCPO_STAGING_KEY=
# SHOPWARE_STAGING_READONLY=false
MYSQL_STAGING_USER=
MYSQL_STAGING_PASSWORD=
MYSQL_STAGING_DB=
