    "type": "prometheus",
    "uid": "prometheus-maxcluster"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",instance=\"localhost:9100\"} / node_filesystem_size_bytes{mountpoint=\"/\",instance=\"localhost:9100\"})",
     "instant": true
