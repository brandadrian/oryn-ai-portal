  {
   "id": 102,
   "type": "stat",
   "title": "SSH: fehlgeschlagene Anmeldungen",
   "description": "Fehlgeschlagene oder ungültige SSH-Anmeldeversuche laut auth.log (meist automatisierte Scans).",
   "datasource": {
    "type": "loki",
    "uid": "loki-maxcluster"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 31
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(count_over_time({job=\"varlogs\", filename=\"/var/log/auth.log\"} |~ \"Failed password|Invalid user|authentication failure|Connection closed by authenticating user\" [$__range]))",
     "queryType": "instant"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 50
       },
       {
        "color": "red",
        "value": 1000
       }
      ]
     }
    },
    "overrides": []
   }
  },
