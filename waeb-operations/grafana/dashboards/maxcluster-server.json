        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Last pro Kern",
   "description": "Load (5 min) geteilt durch Anzahl Kerne. Über 1 = mehr Arbeit als Kerne.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-maxcluster"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_load5{instance=\"localhost:9100\"} / scalar(count(node_cpu_seconds_total{mode=\"idle\",instance=\"localhost:9100\"}))",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Netz eingehend",
   "description": "Eingehender Netzverkehr auf eth0.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-maxcluster"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(node_network_receive_bytes_total{device=\"eth0\",instance=\"localhost:9100\"}[5m])",
