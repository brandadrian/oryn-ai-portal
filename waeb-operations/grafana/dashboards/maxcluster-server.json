{
 "uid": "maxcluster-server",
 "title": "Server (Metriken und /var/log)",
 "tags": [
  "maxcluster",
  "server",
  "prometheus"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "description": "CPU, RAM, Disk, Last und Netzwerk des Maxcluster-Servers (Prometheus, node_exporter).",
 "links": [
  {
   "title": "PROD Logs",
   "type": "link",
   "url": "/d/prod-logs",
   "icon": "doc"
  },
  {
   "title": "STAGING Logs",
   "type": "link",
   "url": "/d/staging-logs",
   "icon": "doc"
  },
  {
   "title": "Server",
   "type": "link",
   "url": "/d/maxcluster-server",
   "icon": "dashboard"
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Jetzt",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "CPU",
   "description": "Durchschnittliche CPU-Auslastung aller 6 Kerne (5 min).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-maxcluster"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\",instance=\"localhost:9100\"}[5m])))",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "RAM belegt",
   "description": "Belegter Arbeitsspeicher ohne Cache (MemAvailable).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-maxcluster"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=\"localhost:9100\"} / node_memory_MemTotal_bytes{instance=\"localhost:9100\"})",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Disk / belegt",
   "description": "Belegung der Systempartition /.",
