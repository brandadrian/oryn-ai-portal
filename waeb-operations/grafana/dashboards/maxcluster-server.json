  {
   "id": 9,
   "type": "timeseries",
   "title": "CPU nach Art",
   "description": "CPU-Zeit nach Art: user (PHP, MySQL …), system (Kernel), iowait (warten auf Disk), steal (vom Hoster abgezogen).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-maxcluster"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * avg by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\",instance=\"localhost:9100\"}[5m]))",
     "legendFormat": "{{mode}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 40,
      "stacking": {
       "mode": "normal"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Arbeitsspeicher",
   "description": "Belegter Speicher, Datei-Cache und Gesamtspeicher (22 GB).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-maxcluster"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemTotal_bytes{instance=\"localhost:9100\"} - node_memory_MemAvailable_bytes{instance=\"localhost:9100\"}",
     "legendFormat": "belegt"
    },
    {
     "refId": "B",
     "expr": "node_memory_Cached_bytes{instance=\"localhost:9100\"} + node_memory_Buffers_bytes{instance=\"localhost:9100\"}",
     "legendFormat": "Cache/Buffer"
    },
    {
     "refId": "C",
     "expr": "node_memory_MemTotal_bytes{instance=\"localhost:9100\"}",
     "legendFormat": "gesamt"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Last (Load)",
   "description": "Systemlast. Liegt sie dauerhaft über der Zahl der Kerne (6), wartet Arbeit.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-maxcluster"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_load1{instance=\"localhost:9100\"}",
     "legendFormat": "1 min"
