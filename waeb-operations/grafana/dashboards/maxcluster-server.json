    {
     "refId": "B",
     "expr": "node_load5{instance=\"localhost:9100\"}",
     "legendFormat": "5 min"
    },
    {
     "refId": "C",
     "expr": "node_load15{instance=\"localhost:9100\"}",
     "legendFormat": "15 min"
    },
    {
     "refId": "D",
     "expr": "count(node_cpu_seconds_total{mode=\"idle\",instance=\"localhost:9100\"})",
