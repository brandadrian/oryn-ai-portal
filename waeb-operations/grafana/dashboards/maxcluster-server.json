        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Läuft seit",
   "description": "Zeit seit dem letzten Neustart des Servers.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-maxcluster"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - node_boot_time_seconds{instance=\"localhost:9100\"}",
     "instant": true
