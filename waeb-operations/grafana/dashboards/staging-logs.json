  {
   "id": 8,
   "type": "timeseries",
   "title": "Fehler pro Kanal",
   "description": "Fehler (ERROR und höher) über die Zeit, aufgeteilt nach Monolog-Kanal (Plugin bzw. Bereich).",
   "datasource": {
    "type": "loki",
    "uid": "loki-maxcluster"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (channel) (count_over_time({job=\"shopware_stage\"} | regexp `\\] (?P<channel>[A-Za-z0-9_-]+)\\.(?P<level>[A-Z]+): (?P<msg>[^\\[{]{0,160})` | level=~\"ERROR|CRITICAL|ALERT|EMERGENCY\" [$__interval]))",
     "queryType": "range",
     "legendFormat": "{{channel}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 9,
   "type": "table",
   "title": "Häufigste Fehler",
   "description": "Die 15 häufigsten Fehlermeldungen im Zeitraum, ohne Kontext-Daten am Zeilenende.",
   "datasource": {
    "type": "loki",
    "uid": "loki-maxcluster"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(15, sum by (channel, msg) (count_over_time({job=\"shopware_stage\"} | regexp `\\] (?P<channel>[A-Za-z0-9_-]+)\\.(?P<level>[A-Z]+): (?P<msg>[^\\[{]{0,160})` | level=~\"ERROR|CRITICAL|ALERT|EMERGENCY\" [$__range])))",
     "queryType": "instant",
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "indexByName": {
       "Value": 0,
       "channel": 1,
       "msg": 2
      },
      "renameByName": {
       "Value": "Anzahl",
       "channel": "Kanal",
       "msg": "Meldung"
      }
     }
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": [
     {
      "displayName": "Anzahl",
      "desc": true
     }
    ]
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Anzahl"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 80
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Kanal"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 240
       }
      ]
     }
    ]
   }
  },
